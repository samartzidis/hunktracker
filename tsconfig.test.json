{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out-test",
    "lib": ["ES2020"],
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "src/test/**/*.ts",
    "src/changeStrip.ts",
    "src/containerOptions.ts",
    "src/diffEngine.ts",
    "src/fileOrder.ts",
    "src/hunktrackerGit.ts",
    "src/pathNormalize.ts",
    "src/progress.ts",
    "src/ignorePatterns.ts",
    "src/storageCleanup.ts",
    "src/proposedApi.ts"
  ],
  "exclude": [
    "node_modules",
    "src/test/integration/**"
  ]
}
