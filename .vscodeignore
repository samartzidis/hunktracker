# isomorphic-git (the baseline store). vsce applies the "!" lines after the plain ones, so exclusions cannot be
# layered on top of a whole-package include: list only the files it loads at run time (the CommonJS builds)
!node_modules/isomorphic-git/package.json
!node_modules/isomorphic-git/LICENSE.md
!node_modules/isomorphic-git/index.cjs
!node_modules/isomorphic-git/managers/index.cjs
