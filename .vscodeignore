!node_modules/isomorphic-git/node_modules/ignore/package.json
!node_modules/isomorphic-git/node_modules/ignore/LICENSE-MIT
!node_modules/isomorphic-git/node_modules/ignore/index.js
!node_modules/isomorphic-git/node_modules/ignore/legacy.js

